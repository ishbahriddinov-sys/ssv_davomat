# ==================== Приложение ====================
APP_NAME="MoH Attendance Bot"
APP_ENV=development            # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=uz            # uz | ru | en

# ==================== Telegram ====================
BOT_TOKEN=123456:ABC-DEF-your-telegram-bot-token
# Через запятую Telegram ID суперадминистраторов (для первичного бутстрапа ролей)
BOOTSTRAP_ADMINS=

# ==================== База данных ====================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance_pass
# Полный DSN формируется автоматически, но можно переопределить:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0

# ==================== Безопасность / шифрование ====================
# 32-байтный ключ в urlsafe base64 (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Разрешённые источники для CORS (через запятую). Пусто = только локальная панель.
# В production укажите точный адрес панели, напр.: https://attendance.minzdrav.uz
CORS_ORIGINS=
# Защита от перебора пароля
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ==================== Геозона Министерства ====================
# Координаты центра территории и радиус (метры)
OFFICE_LATITUDE=41.311081
OFFICE_LONGITUDE=69.240562
OFFICE_RADIUS_METERS=250

# ==================== Рабочий график ====================
WORK_DAY_START=09:30          # начало рабочего дня
WORK_DAY_END=18:00            # конец рабочего дня
LATE_THRESHOLD_MINUTES=10     # порог опоздания в минутах
STANDARD_WORK_HOURS=8         # стандартная норма часов

# ==================== QR ====================
QR_TTL_SECONDS=120            # срок жизни QR-кода (сек)

# ==================== Web Admin ====================
ADMIN_PANEL_PORT=8000

# ==================== Telegram Mini App ====================
WEBAPP_URL=
