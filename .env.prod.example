# ============ PRODUCTION .env (свой сервер) ============
# Скопируйте в .env и заполните. НЕ коммитьте .env в git.

# ---- Домен (для Caddy + Mini App) ----
DOMAIN=ssvdavomat.uz

# ---- Приложение ----
APP_ENV=production
DEBUG=false
DEFAULT_LANGUAGE=uz
TIMEZONE=Asia/Tashkent
SECRET_KEY=            # длинная случайная строка: openssl rand -hex 32
JWT_SECRET=            # ещё одна: openssl rand -hex 32

# ---- Telegram ----
BOT_TOKEN=             # токен от @BotFather
# Бот в режиме polling (VPS всегда включён) — отдельный процесс, HTTPS не требуется
BOT_WEBHOOK_ENABLED=false
# Публичный адрес Mini App (панель за Caddy по HTTPS)
WEBAPP_URL=https://ssvdavomat.uz/api/webapp/
# (необязательно) Telegram ID администраторов через запятую
BOOTSTRAP_ADMINS=

# ---- База данных (локальный PostgreSQL в compose — данные на вашем сервере) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=       # придумайте надёжный пароль
# Чтобы использовать внешнюю БД (Supabase) — задайте DATABASE_URL вместо POSTGRES_*:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Redis (в compose) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=true

# ---- Шифрование ПДн (ОБЯЗАТЕЛЬНО) ----
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Геозона Министерства ----
OFFICE_LATITUDE=41.311081
OFFICE_LONGITUDE=69.240562
OFFICE_RADIUS_METERS=250

# ---- График ----
WORK_DAY_START=09:30
WORK_DAY_END=18:00
LATE_THRESHOLD_MINUTES=10

# ---- Защита входа ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
# CORS: панель за своим доменом
CORS_ORIGINS=https://ssvdavomat.uz
